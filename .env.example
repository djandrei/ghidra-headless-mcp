# Copy to .env to override compose defaults. Paths are relative to this file.
#
# This file DOES now hold a secret: GHMCP_API_KEY. .env is gitignored; keep it
# that way, and do not paste the key into a notebook, a prompt or a write-up.

# Bearer token every HTTP client must send. REQUIRED — both HTTP surfaces
# refuse to start without it, because every tool is reachable over them and
# run_ghidra_script executes arbitrary Ghidra scripts. stdio needs no key.
#
# Generate one with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
#GHMCP_API_KEY=

# Bind address and port for the --http surface (native MCP at /mcp, plain
# HTTP/JSON at /api) on a host run. Under compose, GHMCP_HTTP_PORT is instead
# the host port the ghidra-headless-mcp-http service is published on; the
# container always listens on 1351, on 0.0.0.0 confined by compose's ports:.
#GHMCP_HTTP_HOST=127.0.0.1
#GHMCP_HTTP_PORT=1351

# Binaries to analyse: a host directory mounted read-only into the container,
# and where it appears there. Pass analyze_binary paths under SAMPLES_MOUNT.
#SAMPLES_DIR=./samples
#SAMPLES_MOUNT=/samples
#
# Sharing a path with another container -- the Building Agentic RE course
# devcontainer, for instance -- makes one binary path valid in both:
#SAMPLES_DIR=../building-agentic-re
#SAMPLES_MOUNT=/workspaces/building-agentic-re

# Host-side port. The container always listens on 1341.
#MCPO_PORT=1341

# Bind address for the mcpo surface. Loopback by default; mcpo's own default is
# 0.0.0.0, which would put every tool on the LAN. The container sets this to
# 0.0.0.0 itself and confines exposure with compose's `ports:` instead.
#MCPO_HOST=127.0.0.1

# Docker bridge gateway, i.e. what host.docker.internal resolves to inside other
# containers on this host. Check with: ip -4 addr show docker0
#DOCKER_BRIDGE_IP=172.17.0.1

# The compose network's name, fixed so a companion stack (Keystone) can join it.
#GHMCP_NETWORK=ghidra-headless-mcp

# Passed through to the server.
#
# Set PROJECT_NAME when another copy of this server, running as a different
# user, also uses ./projects-docker: Ghidra refuses to open a project created
# under another username (NotOwnerException), so each needs its own name.
#PROJECT_NAME=headless-mcp
#ANALYZE_TIMEOUT_S=1800
#QUERY_TIMEOUT_S=600

# upload_binary: where uploads land, and the largest file it accepts. When a
# model calls it, the bytes pass through the model's context as base64, so keep
# the cap modest. UPLOAD_DIR defaults to <PROJECT_LOCATION>/samples, i.e.
# /projects/samples here.
#UPLOAD_DIR=/projects/samples
#MAX_UPLOAD_BYTES=4194304
# POST /api/upload (--http only) streams raw bytes with no model in the path,
# so its cap is separate. Set it to at least what your client accepts.
#MAX_STREAM_UPLOAD_BYTES=134217728

# list_chat_uploads: where OpenWebUI keeps chat attachments (its DATA_DIR/uploads),
# as this container sees it. Unset, the server probes the Building Agentic RE
# course's location, /workspaces/building-agentic-re/.openwebui-data/uploads.
#OPENWEBUI_UPLOADS_DIR=/samples/openwebui-uploads

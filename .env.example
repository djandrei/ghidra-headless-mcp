# Copy to .env to override compose defaults. Paths are relative to this file.
#
# This file DOES now hold a secret: GHMCP_API_KEY. .env is gitignored; keep it
# that way, and do not paste the key into a notebook, a prompt or a write-up.

# Bearer token every HTTP client must send. REQUIRED — both HTTP surfaces
# refuse to start without it, because every tool is reachable over them and
# run_ghidra_script executes arbitrary Ghidra scripts. stdio needs no key.
#
# Generate one with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
#GHMCP_API_KEY=

# Bind address and port for the native MCP surface (python ghidra_headless_mcp.py
# --http). 1351 is what opencode/opencode.json expects.
#GHMCP_HTTP_HOST=127.0.0.1
#GHMCP_HTTP_PORT=1351

# Course clone to mount read-only at /workspaces/building-agentic-re.
#COURSE_CLONE=../../../building-agentic-re

# Host-side port. The container always listens on 1341.
#MCPO_PORT=1341

# Bind address for the mcpo surface. Loopback by default; mcpo's own default is
# 0.0.0.0, which would put every tool on the LAN. The container sets this to
# 0.0.0.0 itself and confines exposure with compose's `ports:` instead.
#MCPO_HOST=127.0.0.1

# Docker bridge gateway, i.e. what host.docker.internal resolves to inside the
# course devcontainer. Check with: ip -4 addr show docker0
#DOCKER_BRIDGE_IP=172.17.0.1

# Passed through to the server.
#
# Set PROJECT_NAME when the devcontainer's copy of this server also uses
# ./projects-docker: it runs as `vscode`, this container as `ghidra`, and Ghidra
# refuses to open a project created under another username
# (NotOwnerException). headless-mcp-docker keeps the two projects apart.
#PROJECT_NAME=headless-mcp-docker
#ANALYZE_TIMEOUT_S=1800
#QUERY_TIMEOUT_S=600

# upload_binary: where uploads land, and the largest file it accepts. The bytes
# pass through the model's context as base64, so keep the cap modest. UPLOAD_DIR
# defaults to <PROJECT_LOCATION>/samples, i.e. /projects/samples here.
#UPLOAD_DIR=/projects/samples
#MAX_UPLOAD_BYTES=4194304

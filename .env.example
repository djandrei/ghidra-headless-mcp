# Copy to .env to override compose defaults. Paths are relative to this file.
# Unlike the course clone's .env, nothing here is a secret — these are paths and
# ports only. Keep it that way.

# Course clone to mount read-only at /workspaces/building-agentic-re.
#COURSE_CLONE=../../../building-agentic-re

# Host-side port. The container always listens on 1341.
#MCPO_PORT=1341

# Docker bridge gateway, i.e. what host.docker.internal resolves to inside the
# course devcontainer. Check with: ip -4 addr show docker0
#DOCKER_BRIDGE_IP=172.17.0.1

# Passed through to the server.
#PROJECT_NAME=headless-mcp
#ANALYZE_TIMEOUT_S=1800
#QUERY_TIMEOUT_S=600
